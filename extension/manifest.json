{
  "manifest_version": 3,
  "name": "Mvp Web Limpia",
  "version": "1.0",
  "description": "Navegación ética con micropagos automáticos en Nano",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://rpc.nano.to/*",
    "https://app.natrium.io/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}